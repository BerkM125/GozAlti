# Copy to .env (gitignored) and fill in what you have.

# --- RINGS A PHONE -----------------------------------------------------------
# CallMeBot: rings the contact's TELEGRAM and speaks the message. Free, no account.
# The CONTACT authorises once: send /start to @CallMeBot_txtbot on Telegram.
# Then put their @username (or +countrycode number) here.
CALLMEBOT_USER=@their_telegram_username

# Twilio: rings the actual cellular number. Trial credit is free but a trial account
# may only dial numbers you have VERIFIED in the console — a teammate qualifies.
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+15551234567
# CALLING_CONTACT_NUMBER=+15557654321

# --- LOUD NOTIFICATIONS, NOT RINGS -------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...    # @BotFather, ~2 min
# TELEGRAM_CHAT_ID=123456789
# NTFY_TOPIC=gozalti-alerts-8f3k      # no account at all; pick an unguessable topic
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
