# results and caches from the box workbench (rebuildable)
lab/out/
lab/prepped/
lab/log.jsonl
lab/bench/
lab/scene_out/
lab/*.jsonl
# the answer key is an asset, not an artifact — it costs a human labelling pass to recreate
!lab/labels*.jsonl
lab/detect_out/
lab/clips/
lab/video_out/
lab/viewer/data/
lab/assist_out/
# evidence/ is the exception: unreproducible artifacts (live-clip digests, bench
# timings). 36 KB of text, kept so the docs' numbers can be checked. See its README.
!lab/evidence/
!lab/evidence/**
